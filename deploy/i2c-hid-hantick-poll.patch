+/*
+ * The Hantick 0911:5288 controller used by the R1 panel is functional,
+ * but its GPIO interrupt is not delivered by the older DSM 5.10 GPIO
+ * stack. Poll the normal I2C-HID input register and keep standard parsing.
+ */
+static void i2c_hid_poll_work(struct work_struct *work)
+{
+	struct i2c_hid *ihid = container_of(to_delayed_work(work),
+					       struct i2c_hid, poll_work);
+
+	if (test_bit(I2C_HID_STARTED, &ihid->flags) &&
+	    !test_bit(I2C_HID_READ_PENDING, &ihid->flags))
+		i2c_hid_get_input(ihid);
+
+	schedule_delayed_work(&ihid->poll_work, msecs_to_jiffies(8));
+}
